diff --git a/apps/portal/src/api/team.test.ts b/apps/portal/src/api/team.test.ts
new file mode 100644
index 0000000..9f001ea
--- /dev/null
+++ b/apps/portal/src/api/team.test.ts
@@ -0,0 +1,256 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import {
+  HubError,
+  changePassword,
+  resetCsrfCache,
+  updateProfile,
+  type Account,
+  type User,
+} from "./auth";
+import {
+  acceptInvitation,
+  changeRole,
+  fetchInvitations,
+  fetchMembers,
+  inviteMember,
+  lookupInvitation,
+  removeMember,
+  renameOrganization,
+  revokeInvitation,
+  type Invitation,
+} from "./team";
+
+const user: User = {
+  id: "8a6e0804-2bd0-4672-b79d-d97027f9071a",
+  email: "ada@example.com",
+  name: "Ada",
+  role: "owner",
+  email_verified: true,
+};
+
+const account: Account = {
+  user,
+  organization: { id: "0f8fad5b-d9cb-469f-a165-70867728950e", name: "Engines Ltd" },
+};
+
+const invitation: Invitation = {
+  id: "5b1c2a40-6a43-4b84-9a52-2f0b1d7a3c11",
+  email: "grace@example.com",
+  role: "member",
+  created_at: "2026-11-08T10:00:00Z",
+  expires_at: "2026-11-15T10:00:00Z",
+};
+
+interface Call {
+  url: string;
+  method: string;
+  body: unknown;
+  csrf: string | null;
+}
+
+/**
+ * A fake hub, as in `auth.test.ts`: `GET /api/auth/csrf` answers
+ * `csrf-<n>`; every other call is recorded and answered by `status`/`body`.
+ */
+function respond(status: number, body?: unknown) {
+  const calls: Call[] = [];
+  const impl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    const method = init?.method ?? "GET";
+    if (url === "/api/auth/csrf" && method === "GET") {
+      return new Response(JSON.stringify({ csrf_token: "csrf-1" }), {
+        status: 200,
+        headers: { "Content-Type": "application/json" },
+      });
+    }
+    const headers = (init?.headers ?? {}) as Record<string, string>;
+    calls.push({
+      url,
+      method,
+      body: typeof init?.body === "string" ? JSON.parse(init.body) : undefined,
+      csrf: headers["X-CSRF-Token"] ?? null,
+    });
+    const text = body === undefined ? null : JSON.stringify(body);
+    return new Response(text, {
+      status,
+      headers: text ? { "Content-Type": "application/json" } : {},
+    });
+  }) as typeof fetch;
+  return { impl, calls };
+}
+
+beforeEach(() => resetCsrfCache());
+
+async function rejection(p: Promise<unknown>): Promise<unknown> {
+  return p.then(
+    () => undefined,
+    (e: unknown) => e,
+  );
+}
+
+describe("account", () => {
+  it("updateProfile posts the name with a CSRF token", async () => {
+    const f = respond(200, account);
+    expect(await updateProfile("Ada", f.impl)).toEqual(account);
+    expect(f.calls).toEqual([
+      { url: "/api/account/profile", method: "POST", body: { name: "Ada" }, csrf: "csrf-1" },
+    ]);
+  });
+
+  it("changePassword sends both passwords and returns the account", async () => {
+    const f = respond(200, account);
+    expect(await changePassword("old one here", "new one here!", f.impl)).toEqual(account);
+    expect(f.calls).toEqual([
+      {
+        url: "/api/auth/password",
+        method: "POST",
+        body: { current_password: "old one here", new_password: "new one here!" },
+        csrf: "csrf-1",
+      },
+    ]);
+  });
+
+  it("changePassword surfaces a wrong current password", async () => {
+    const f = respond(400, { error: "current password is incorrect" });
+    const err = await rejection(changePassword("x", "new one here!", f.impl));
+    expect(err).toBeInstanceOf(HubError);
+    expect((err as HubError).status).toBe(400);
+    expect((err as HubError).message).toBe("current password is incorrect");
+  });
+});
+
+describe("organization", () => {
+  it("fetchMembers reads the list without a CSRF token", async () => {
+    const f = respond(200, { members: [user] });
+    expect(await fetchMembers(f.impl)).toEqual([user]);
+    expect(f.calls).toEqual([
+      { url: "/api/organization/members", method: "GET", body: undefined, csrf: null },
+    ]);
+  });
+
+  it("fetchMembers rejects an unexpected body", async () => {
+    const f = respond(200, { members: [{ id: 1 }] });
+    const err = await rejection(fetchMembers(f.impl));
+    expect((err as Error).message).toBe("members returned an unexpected body (HTTP 200)");
+  });
+
+  it("renameOrganization posts the name", async () => {
+    const f = respond(200, account.organization);
+    expect(await renameOrganization("New", f.impl)).toEqual(account.organization);
+    expect(f.calls[0]).toEqual({
+      url: "/api/organization",
+      method: "POST",
+      body: { name: "New" },
+      csrf: "csrf-1",
+    });
+  });
+
+  it("an owner-only refusal is a 403 HubError", async () => {
+    const f = respond(403, { error: "only an organization owner can manage the team" });
+    const err = await rejection(renameOrganization("New", f.impl));
+    expect((err as HubError).status).toBe(403);
+    expect((err as HubError).message).toBe("only an organization owner can manage the team");
+  });
+
+  it("changeRole and removeMember address the member by id", async () => {
+    const f = respond(200, { ...user, role: "member" });
+    expect(await changeRole(user.id, "member", f.impl)).toEqual({ ...user, role: "member" });
+    const g = respond(204);
+    await removeMember(user.id, g.impl);
+    expect(f.calls[0]).toEqual({
+      url: `/api/organization/members/${user.id}/role`,
+      method: "POST",
+      body: { role: "member" },
+      csrf: "csrf-1",
+    });
+    expect(g.calls[0]).toEqual({
+      url: `/api/organization/members/${user.id}/remove`,
+      method: "POST",
+      body: undefined,
+      csrf: "csrf-1",
+    });
+  });
+});
+
+describe("invitations", () => {
+  it("inviteMember posts email and role", async () => {
+    const f = respond(201, { invitation, invitation_email_sent: false });
+    expect(await inviteMember("grace@example.com", "member", f.impl)).toEqual({
+      invitation,
+      invitation_email_sent: false,
+    });
+    expect(f.calls[0]).toEqual({
+      url: "/api/organization/invitations",
+      method: "POST",
+      body: { email: "grace@example.com", role: "member" },
+      csrf: "csrf-1",
+    });
+  });
+
+  it("inviteMember keeps the mail limit's Retry-After", async () => {
+    const calls: string[] = [];
+    const impl = (async (input: RequestInfo | URL) => {
+      const url = String(input);
+      calls.push(url);
+      if (url === "/api/auth/csrf") {
+        return new Response(JSON.stringify({ csrf_token: "c" }), { status: 200 });
+      }
+      return new Response(JSON.stringify({ error: "too many emails requested; try again later" }), {
+        status: 429,
+        headers: { "Retry-After": "120" },
+      });
+    }) as typeof fetch;
+    const err = await rejection(inviteMember("a@example.com", "owner", impl));
+    expect((err as HubError).status).toBe(429);
+    expect((err as HubError).retryAfterSecs).toBe(120);
+  });
+
+  it("fetchInvitations and revokeInvitation", async () => {
+    const f = respond(200, { invitations: [invitation] });
+    expect(await fetchInvitations(f.impl)).toEqual([invitation]);
+    const g = respond(204);
+    await revokeInvitation(invitation.id, g.impl);
+    expect(f.calls[0].url).toBe("/api/organization/invitations");
+    expect(g.calls[0]).toEqual({
+      url: `/api/organization/invitations/${invitation.id}/revoke`,
+      method: "POST",
+      body: undefined,
+      csrf: "csrf-1",
+    });
+  });
+
+  it("fetchInvitations rejects a role the hub never assigns", async () => {
+    const f = respond(200, { invitations: [{ ...invitation, role: "vendor_admin" }] });
+    await expect(fetchInvitations(f.impl)).rejects.toThrow("unexpected body");
+  });
+
+  it("lookupInvitation returns the preview", async () => {
+    const preview = { organization_name: "Engines Ltd", email: "g@example.com", role: "owner" };
+    const f = respond(200, preview);
+    expect(await lookupInvitation("tok", f.impl)).toEqual(preview);
+    expect(f.calls[0]).toEqual({
+      url: "/api/invitations/lookup",
+      method: "POST",
+      body: { token: "tok" },
+      csrf: "csrf-1",
+    });
+  });
+
+  it("lookupInvitation surfaces an unusable token", async () => {
+    const f = respond(400, { error: "this invitation is invalid or has expired" });
+    const err = await rejection(lookupInvitation("tok", f.impl));
+    expect((err as HubError).message).toBe("this invitation is invalid or has expired");
+  });
+
+  it("acceptInvitation posts token, name and password and returns the account", async () => {
+    const f = respond(201, account);
+    const input = { token: "tok", name: "Grace", password: "correct horse battery" };
+    expect(await acceptInvitation(input, f.impl)).toEqual(account);
+    expect(f.calls[0]).toEqual({
+      url: "/api/invitations/accept",
+      method: "POST",
+      body: input,
+      csrf: "csrf-1",
+    });
+  });
+});
diff --git a/apps/portal/src/api/team.ts b/apps/portal/src/api/team.ts
new file mode 100644
index 0000000..e3acd92
--- /dev/null
+++ b/apps/portal/src/api/team.ts
@@ -0,0 +1,182 @@
+// Mirrors the organization, team and invitation routes in
+// crates/wipe-hub/src/team_routes.rs and `wipe_hub::team::{Invitation,
+// InvitationPreview}` (crates/wipe-hub/src/team.rs). Change both together.
+//
+// The hub decides who may do what (owners manage the team; an organization
+// keeps at least one owner). The portal only hides controls a member cannot
+// use; it never re-implements those rules.
+
+import {
+  ensureOk,
+  isAccount,
+  isObject,
+  isOrganization,
+  isUser,
+  json,
+  request,
+  type Account,
+  type Fetch,
+  type Organization,
+  type User,
+} from "./auth";
+
+/** A role an owner can assign. */
+export type AssignableRole = "owner" | "member";
+
+/** A pending invitation. Timestamps are RFC 3339 UTC strings. */
+export interface Invitation {
+  id: string;
+  email: string;
+  role: AssignableRole;
+  created_at: string;
+  expires_at: string;
+}
+
+export interface InviteResult {
+  invitation: Invitation;
+  /** `false` when the hub could not hand the email to SMTP; inviting again re-sends. */
+  invitation_email_sent: boolean;
+}
+
+/** What an invitee sees before accepting. */
+export interface InvitationPreview {
+  organization_name: string;
+  email: string;
+  role: AssignableRole;
+}
+
+export interface AcceptInput {
+  token: string;
+  name: string;
+  password: string;
+}
+
+function isAssignableRole(v: unknown): v is AssignableRole {
+  return v === "owner" || v === "member";
+}
+
+export function isInvitation(v: unknown): v is Invitation {
+  return (
+    isObject(v) &&
+    typeof v.id === "string" &&
+    typeof v.email === "string" &&
+    isAssignableRole(v.role) &&
+    typeof v.created_at === "string" &&
+    typeof v.expires_at === "string"
+  );
+}
+
+function isInviteResult(v: unknown): v is InviteResult {
+  return isObject(v) && isInvitation(v.invitation) && typeof v.invitation_email_sent === "boolean";
+}
+
+function isPreview(v: unknown): v is InvitationPreview {
+  return (
+    isObject(v) &&
+    typeof v.organization_name === "string" &&
+    typeof v.email === "string" &&
+    isAssignableRole(v.role)
+  );
+}
+
+function isMembers(v: unknown): v is { members: User[] } {
+  return isObject(v) && Array.isArray(v.members) && v.members.every(isUser);
+}
+
+function isInvitations(v: unknown): v is { invitations: Invitation[] } {
+  return isObject(v) && Array.isArray(v.invitations) && v.invitations.every(isInvitation);
+}
+
+/** `GET /api/organization/members` (any role): the organization's users. */
+export async function fetchMembers(fetchImpl: Fetch = fetch): Promise<User[]> {
+  const res = await ensureOk(await request(fetchImpl, "GET", "/api/organization/members"));
+  return (await json(res, isMembers, "members")).members;
+}
+
+/** `POST /api/organization` (owner): rename the organization. */
+export async function renameOrganization(
+  name: string,
+  fetchImpl: Fetch = fetch,
+): Promise<Organization> {
+  const res = await ensureOk(await request(fetchImpl, "POST", "/api/organization", { name }));
+  return json(res, isOrganization, "rename organization");
+}
+
+/**
+ * `POST /api/organization/invitations` (owner, 201): email an invitation.
+ * Counts against the email-send limit (429, see `emailRequestErrorMessage`).
+ */
+export async function inviteMember(
+  email: string,
+  role: AssignableRole,
+  fetchImpl: Fetch = fetch,
+): Promise<InviteResult> {
+  const res = await ensureOk(
+    await request(fetchImpl, "POST", "/api/organization/invitations", { email, role }),
+  );
+  return json(res, isInviteResult, "invite");
+}
+
+/** `GET /api/organization/invitations` (owner): pending invitations. */
+export async function fetchInvitations(fetchImpl: Fetch = fetch): Promise<Invitation[]> {
+  const res = await ensureOk(await request(fetchImpl, "GET", "/api/organization/invitations"));
+  return (await json(res, isInvitations, "invitations")).invitations;
+}
+
+/** `POST /api/organization/invitations/{id}/revoke` (owner, 204). */
+export async function revokeInvitation(id: string, fetchImpl: Fetch = fetch): Promise<void> {
+  await ensureOk(
+    await request(
+      fetchImpl,
+      "POST",
+      `/api/organization/invitations/${encodeURIComponent(id)}/revoke`,
+    ),
+  );
+}
+
+/** `POST /api/organization/members/{id}/role` (owner): the updated member. */
+export async function changeRole(
+  id: string,
+  role: AssignableRole,
+  fetchImpl: Fetch = fetch,
+): Promise<User> {
+  const res = await ensureOk(
+    await request(fetchImpl, "POST", `/api/organization/members/${encodeURIComponent(id)}/role`, {
+      role,
+    }),
+  );
+  return json(res, isUser, "change role");
+}
+
+/** `POST /api/organization/members/{id}/remove` (owner, 204). */
+export async function removeMember(id: string, fetchImpl: Fetch = fetch): Promise<void> {
+  await ensureOk(
+    await request(fetchImpl, "POST", `/api/organization/members/${encodeURIComponent(id)}/remove`),
+  );
+}
+
+/**
+ * `POST /api/invitations/lookup` (anonymous): who invited the token's holder
+ * where, as what. Consumes nothing. An unusable token is a 400 `HubError`.
+ */
+export async function lookupInvitation(
+  token: string,
+  fetchImpl: Fetch = fetch,
+): Promise<InvitationPreview> {
+  const res = await ensureOk(
+    await request(fetchImpl, "POST", "/api/invitations/lookup", { token }),
+  );
+  return json(res, isPreview, "invitation lookup");
+}
+
+/**
+ * `POST /api/invitations/accept` (anonymous, 201): create the account in the
+ * inviting organization and sign in.
+ */
+export async function acceptInvitation(
+  input: AcceptInput,
+  fetchImpl: Fetch = fetch,
+): Promise<Account> {
+  const res = await ensureOk(await request(fetchImpl, "POST", "/api/invitations/accept", input));
+  return json(res, isAccount, "accept invitation");
+}
