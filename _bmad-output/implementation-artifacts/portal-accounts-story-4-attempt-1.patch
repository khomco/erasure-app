+++ b/apps/portal/src/pages/OrganizationPage.tsx
@@ -0,0 +1,255 @@
+import { useState, type FormEvent } from "react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { emailRequestErrorMessage, fetchMe, type Account, type User } from "@/api/auth";
+import {
+  changeRole,
+  fetchInvitations,
+  fetchMembers,
+  inviteMember,
+  removeMember,
+  renameOrganization,
+  revokeInvitation,
+  type AssignableRole,
+} from "@/api/team";
+import { SignInPrompt } from "./AccountPage";
+import { Field, FormError, SubmitButton } from "./AuthForm";
+
+/**
+ * `/organization`: the organization's name, its members and, for owners,
+ * invitations and member management. Hiding owner controls from members is
+ * a convenience only: the hub refuses them anyway.
+ */
+export function OrganizationPage() {
+  const me = useQuery({ queryKey: ["me"], queryFn: () => fetchMe(), retry: false });
+
+  return (
+    <section className="space-y-6">
+      <h1 className="text-xl font-semibold">Organization</h1>
+      {me.isPending && <p className="text-sm text-slate-400">Loading…</p>}
+      {me.isError && (
+        <p role="alert" className="text-sm text-rose-400">
+          Could not load your account: {me.error instanceof Error ? me.error.message : "unknown error"}
+        </p>
+      )}
+      {me.data === null && <SignInPrompt />}
+      {me.data && <Organization account={me.data} />}
+    </section>
+  );
+}
+
+function Organization({ account }: { account: Account }) {
+  const isOwner = account.user.role === "owner";
+  return (
+    <>
+      {isOwner ? (
+        <RenameForm name={account.organization.name} />
+      ) : (
+        <p className="text-sm">{account.organization.name}</p>
+      )}
+      <Members self={account.user} isOwner={isOwner} />
+      {isOwner && (
+        <>
+          <InviteForm />
+          <Invitations />
+        </>
+      )}
+    </>
+  );
+}
+
+function RenameForm({ name: initial }: { name: string }) {
+  const queryClient = useQueryClient();
+  const [name, setName] = useState(initial);
+  const mutation = useMutation({
+    mutationFn: () => renameOrganization(name),
+    onSuccess: (organization) => {
+      queryClient.setQueryData<Account | null>(["me"], (old) =>
+        old ? { ...old, organization } : old,
+      );
+      setName(organization.name);
+    },
+  });
+
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    mutation.mutate();
+  }
+
+  return (
+    <form onSubmit={onSubmit} className="max-w-sm space-y-3">
+      <Field label="Organization name" name="organization" value={name} onChange={setName} />
+      <FormError error={mutation.error} />
+      {mutation.isSuccess && (
+        <p role="status" className="text-sm text-emerald-400">
+          Saved.
+        </p>
+      )}
+      <SubmitButton pending={mutation.isPending}>Rename</SubmitButton>
+    </form>
+  );
+}
+
+function Members({ self, isOwner }: { self: User; isOwner: boolean }) {
+  const members = useQuery({ queryKey: ["members"], queryFn: () => fetchMembers() });
+
+  return (
+    <div className="space-y-2">
+      <h2 className="text-sm font-medium text-slate-400">Members</h2>
+      {members.isPending && <p className="text-sm text-slate-400">Loading…</p>}
+      <FormError error={members.error} />
+      {members.data && (
+        <ul className="divide-y divide-slate-800 rounded-md border border-slate-800">
+          {members.data.map((m) => (
+            <MemberRow key={m.id} member={m} self={self} isOwner={isOwner} />
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+function MemberRow({ member, self, isOwner }: { member: User; self: User; isOwner: boolean }) {
+  const queryClient = useQueryClient();
+  const refresh = () => {
+    void queryClient.invalidateQueries({ queryKey: ["members"] });
+    // Demoting yourself changes what this page shows you.
+    if (member.id === self.id) void queryClient.invalidateQueries({ queryKey: ["me"] });
+  };
+  const role = useMutation({
+    mutationFn: (r: AssignableRole) => changeRole(member.id, r),
+    onSuccess: refresh,
+  });
+  const remove = useMutation({ mutationFn: () => removeMember(member.id), onSuccess: refresh });
+  const manageable = isOwner && member.role !== "vendor_admin";
+  const isSelf = member.id === self.id;
+
+  return (
+    <li className="space-y-1 px-3 py-2 text-sm">
+      <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
+        <span className="font-medium">{member.name}</span>
+        <span className="text-slate-400">{member.email}</span>
+        {isSelf && <span className="text-slate-500">(you)</span>}
+        <span className="ml-auto flex items-center gap-2">
+          {manageable ? (
+            <select
+              aria-label={`Role of ${member.name}`}
+              value={member.role}
+              disabled={role.isPending}
+              onChange={(e) => role.mutate(e.target.value as AssignableRole)}
+              className="rounded-md border border-slate-700 bg-slate-900 px-2 py-1"
+            >
+              <option value="owner">owner</option>
+              <option value="member">member</option>
+            </select>
+          ) : (
+            <span className="text-slate-400">{member.role}</span>
+          )}
+          {manageable && !isSelf && (
+            <button
+              type="button"
+              disabled={remove.isPending}
+              onClick={() => {
+                if (window.confirm(`Remove ${member.name} (${member.email}) from the organization?`)) {
+                  remove.mutate();
+                }
+              }}
+              className="rounded-md border border-slate-700 px-2 py-1 hover:bg-slate-800 disabled:opacity-50"
+            >
+              Remove
+            </button>
+          )}
+        </span>
+      </div>
+      <FormError error={role.error ?? remove.error} />
+    </li>
+  );
+}
+
+function InviteForm() {
+  const queryClient = useQueryClient();
+  const [email, setEmail] = useState("");
+  const [role, setRole] = useState<AssignableRole>("member");
+  const mutation = useMutation({
+    mutationFn: () => inviteMember(email, role),
+    onSuccess: () => {
+      void queryClient.invalidateQueries({ queryKey: ["invitations"] });
+      setEmail("");
+    },
+  });
+
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    mutation.mutate();
+  }
+
+  return (
+    <form onSubmit={onSubmit} className="max-w-sm space-y-3">
+      <h2 className="text-sm font-medium text-slate-400">Invite someone</h2>
+      <Field
+        label="Email"
+        name="invite-email"
+        type="email"
+        autoComplete="off"
+        value={email}
+        onChange={setEmail}
+      />
+      <label className="block space-y-1 text-sm">
+        <span className="text-slate-300">Role</span>
+        <select
+          name="invite-role"
+          value={role}
+          onChange={(e) => setRole(e.target.value as AssignableRole)}
+          className="w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100"
+        >
+          <option value="member">member</option>
+          <option value="owner">owner</option>
+        </select>
+      </label>
+      <FormError error={mutation.error} describe={emailRequestErrorMessage} />
+      {mutation.data && (
+        <p role="status" className="text-sm text-emerald-400">
+          {mutation.data.invitation_email_sent
+            ? `Invitation sent to ${mutation.data.invitation.email}. The link works once and expires in 7 days.`
+            : `The invitation for ${mutation.data.invitation.email} was created, but the email could not be sent. Invite again to re-send it.`}
+        </p>
+      )}
+      <SubmitButton pending={mutation.isPending}>Send invitation</SubmitButton>
+    </form>
+  );
+}
+
+function Invitations() {
+  const queryClient = useQueryClient();
+  const invitations = useQuery({ queryKey: ["invitations"], queryFn: () => fetchInvitations() });
+  const revoke = useMutation({
+    mutationFn: (id: string) => revokeInvitation(id),
+    onSettled: () => queryClient.invalidateQueries({ queryKey: ["invitations"] }),
+  });
+
+  return (
+    <div className="space-y-2">
+      <h2 className="text-sm font-medium text-slate-400">Pending invitations</h2>
+      <FormError error={invitations.error ?? revoke.error} />
+      {invitations.data?.length === 0 && <p className="text-sm text-slate-400">None.</p>}
+      {invitations.data && invitations.data.length > 0 && (
+        <ul className="divide-y divide-slate-800 rounded-md border border-slate-800">
+          {invitations.data.map((inv) => (
+            <li key={inv.id} className="flex flex-wrap items-center gap-3 px-3 py-2 text-sm">
+              <span>{inv.email}</span>
+              <span className="text-slate-400">{inv.role}</span>
+              <span className="text-slate-500">expires {inv.expires_at.slice(0, 10)}</span>
+              <button
+                type="button"
+                disabled={revoke.isPending}
+                onClick={() => revoke.mutate(inv.id)}
+                className="ml-auto rounded-md border border-slate-700 px-2 py-1 hover:bg-slate-800 disabled:opacity-50"
+              >
+                Revoke
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
diff --git a/crates/wipe-hub/migrations/0006_invitations.sql b/crates/wipe-hub/migrations/0006_invitations.sql
new file mode 100644
index 0000000..cb8a18d
--- /dev/null
+++ b/crates/wipe-hub/migrations/0006_invitations.sql
@@ -0,0 +1,25 @@
+-- Team invitations (ADR-0007 §3, portal-accounts story 4).
+-- A new table rather than an `auth_tokens` purpose: those tokens belong to an
+-- existing user, and an invitee has no user row until they accept.
+-- Only the SHA-256 of the emailed secret is stored. An invitation is pending
+-- while `accepted_at` and `revoked_at` are null and `expires_at` is in the
+-- future; accepting creates the user in `organization_id` with `role`.
+-- Roles are customer-side only: an invitation never creates a vendor admin.
+--
+-- Never edit an applied migration; add a new NNNN_name.sql.
+
+CREATE TABLE invitations (
+    id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    organization_id uuid NOT NULL REFERENCES organizations (id) ON DELETE CASCADE,
+    email           text NOT NULL CHECK (email ~ '\S'),
+    role            text NOT NULL CHECK (role IN ('owner', 'member')),
+    token_hash      bytea NOT NULL CHECK (octet_length(token_hash) = 32),
+    invited_by      uuid REFERENCES users (id) ON DELETE SET NULL,
+    created_at      timestamptz NOT NULL DEFAULT now(),
+    expires_at      timestamptz NOT NULL,
+    accepted_at     timestamptz,
+    revoked_at      timestamptz,
+    CONSTRAINT invitations_token_hash_key UNIQUE (token_hash)
+);
+
+CREATE INDEX invitations_organization_email_idx ON invitations (organization_id, lower(email));
diff --git a/crates/wipe-hub/src/team.rs b/crates/wipe-hub/src/team.rs
new file mode 100644
index 0000000..342cd48
--- /dev/null
+++ b/crates/wipe-hub/src/team.rs
@@ -0,0 +1,489 @@
+//! Organization and team data layer (ADR-0007 §3, portal-accounts story 4):
+//! members, roles, the organization's name and invitations.
+//!
+//! Every function that reads or writes one organization's records takes its
+//! `organization_id` first, and handlers pass the signed-in user's, from the
+//! session, never one from the request. A user or invitation id from another
+//! organization therefore matches nothing, exactly like an unknown id.
+//!
+//! - Only `owner` and `member` are assignable or targetable here; a
+//!   `vendor_admin` is never found by [`member`] and never created.
+//! - Role changes and removals run after [`lock_organization`] (`SELECT …
+//!   FOR UPDATE` on the organization row), so the at-least-one-owner check
+//!   cannot race: two owners demoting each other are serialised.
+//! - Invitation tokens are 32 OS-RNG bytes; only their SHA-256 is stored
+//!   ([`accounts::Token`]). The raw token leaves only in the invitation email.
+//! - Timestamps are RFC 3339 UTC strings formatted in SQL.
+//!
+//! Functions take any Postgres executor (or a connection, when they run more
+//! than one statement) so callers can put a write and its audit row in one
+//! transaction.
+
+use std::str::FromStr;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+use crate::accounts::{self, CreateAccountError, Role, Token, User};
+
+/// How long an invitation link is valid.
+pub const INVITATION_TTL: Duration = Duration::from_secs(7 * 24 * 60 * 60);
+
+/// `to_char` format for RFC 3339 UTC, whole seconds.
+const RFC3339_UTC: &str = r#"'YYYY-MM-DD"T"HH24:MI:SS"Z"'"#;
+
+/// A pending invitation as the API shows it. Never carries the token.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Invitation {
+    pub id: Uuid,
+    pub email: String,
+    pub role: Role,
+    /// RFC 3339, UTC.
+    pub created_at: String,
+    /// RFC 3339, UTC.
+    pub expires_at: String,
+}
+
+/// A newly created invitation and the raw token for its email.
+pub struct IssuedInvitation {
+    pub token: String,
+    pub invitation: Invitation,
+}
+
+/// What an invitee sees before accepting: who invited them where, as what.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct InvitationPreview {
+    pub organization_name: String,
+    pub email: String,
+    pub role: Role,
+}
+
+/// An invitation that [`consume_invitation`] just marked accepted.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AcceptedInvitation {
+    pub id: Uuid,
+    pub organization_id: Uuid,
+    pub email: String,
+    pub role: Role,
+}
+
+/// What [`remove_member`] deleted.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RemovedMember {
+    pub email: String,
+    pub role: Role,
+    pub sessions_ended: i64,
+}
+
+pub const MSG_BAD_ROLE: &str = "role must be owner or member";
+
+/// A role an owner may assign: `owner` or `member`, nothing else.
+pub fn assignable_role(s: &str) -> Result<Role, String> {
+    match s {
+        "owner" => Ok(Role::Owner),
+        "member" => Ok(Role::Member),
+        _ => Err(MSG_BAD_ROLE.into()),
+    }
+}
+
+fn decode_role(s: &str) -> Result<Role, sqlx::Error> {
+    Role::from_str(s).map_err(|e| sqlx::Error::Decode(e.into()))
+}
+
+type UserRow = (Uuid, String, String, String, bool);
+
+fn user_of((id, email, name, role, email_verified): UserRow) -> Result<User, sqlx::Error> {
+    Ok(User {
+        id,
+        email,
+        name,
+        role: decode_role(&role)?,
+        email_verified,
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Members and the organization
+
+/// Every user of the organization, ordered by name then email.
+pub async fn members<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+) -> Result<Vec<User>, sqlx::Error> {
+    let rows: Vec<UserRow> = sqlx::query_as(
+        "SELECT id, email, name, role, email_verified_at IS NOT NULL FROM users \
+         WHERE organization_id = $1 ORDER BY name, lower(email), id",
+    )
+    .bind(organization_id)
+    .fetch_all(executor)
+    .await?;
+    rows.into_iter().map(user_of).collect()
+}
+
+/// One `owner` or `member` of the organization; `None` for an unknown id,
+/// another organization's user or a `vendor_admin`.
+pub async fn member<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    user_id: Uuid,
+) -> Result<Option<User>, sqlx::Error> {
+    let row: Option<UserRow> = sqlx::query_as(
+        "SELECT id, email, name, role, email_verified_at IS NOT NULL FROM users \
+         WHERE organization_id = $1 AND id = $2 AND role IN ('owner', 'member')",
+    )
+    .bind(organization_id)
+    .bind(user_id)
+    .fetch_optional(executor)
+    .await?;
+    row.map(user_of).transpose()
+}
+
+/// Set a user's own name; `false` if they are not in the organization.
+pub async fn set_user_name<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    user_id: Uuid,
+    name: &str,
+) -> Result<bool, sqlx::Error> {
+    let done = sqlx::query("UPDATE users SET name = $3 WHERE organization_id = $1 AND id = $2")
+        .bind(organization_id)
+        .bind(user_id)
+        .bind(name)
+        .execute(executor)
+        .await?;
+    Ok(done.rows_affected() > 0)
+}
+
+/// Lock the organization row (`FOR UPDATE`) until the transaction ends and
+/// return its name. Every role change, removal and rename takes this lock
+/// first, so owner counts read after it are stable.
+pub async fn lock_organization<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+) -> Result<Option<String>, sqlx::Error> {
+    sqlx::query_scalar("SELECT name FROM organizations WHERE id = $1 FOR UPDATE")
+        .bind(organization_id)
+        .fetch_optional(executor)
+        .await
+}
+
+/// Rename the organization.
+pub async fn rename_organization<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    name: &str,
+) -> Result<(), sqlx::Error> {
+    sqlx::query("UPDATE organizations SET name = $2 WHERE id = $1")
+        .bind(organization_id)
+        .bind(name)
+        .execute(executor)
+        .await?;
+    Ok(())
+}
+
+/// How many `owner`s the organization has.
+pub async fn owner_count<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+) -> Result<i64, sqlx::Error> {
+    sqlx::query_scalar("SELECT count(*) FROM users WHERE organization_id = $1 AND role = 'owner'")
+        .bind(organization_id)
+        .fetch_one(executor)
+        .await
+}
+
+/// Set an `owner`'s or `member`'s role to `role` (`owner` or `member`);
+/// `false` if no such member.
+pub async fn set_role<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    user_id: Uuid,
+    role: Role,
+) -> Result<bool, sqlx::Error> {
+    debug_assert!(matches!(role, Role::Owner | Role::Member));
+    let done = sqlx::query(
+        "UPDATE users SET role = $3 \
+         WHERE organization_id = $1 AND id = $2 AND role IN ('owner', 'member') \
+           AND $3 IN ('owner', 'member')",
+    )
+    .bind(organization_id)
+    .bind(user_id)
+    .bind(role.as_str())
+    .execute(executor)
+    .await?;
+    Ok(done.rows_affected() > 0)
+}
+
+/// Delete an `owner` or `member` (their sessions and emailed tokens cascade);
+/// `None` if no such member.
+pub async fn remove_member<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    user_id: Uuid,
+) -> Result<Option<RemovedMember>, sqlx::Error> {
+    let row: Option<(String, String, i64)> = sqlx::query_as(
+        "WITH s AS (SELECT count(*) AS n FROM sessions WHERE user_id = $2) \
+         DELETE FROM users \
+         WHERE organization_id = $1 AND id = $2 AND role IN ('owner', 'member') \
+         RETURNING email, role, (SELECT n FROM s)",
+    )
+    .bind(organization_id)
+    .bind(user_id)
+    .fetch_optional(executor)
+    .await?;
+    row.map(|(email, role, sessions_ended)| {
+        Ok(RemovedMember {
+            email,
+            role: decode_role(&role)?,
+            sessions_ended,
+        })
+    })
+    .transpose()
+}
+
+/// Whether `email` (any case) belongs to a user of this organization.
+pub async fn is_member_email<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    email: &str,
+) -> Result<bool, sqlx::Error> {
+    sqlx::query_scalar(
+        "SELECT EXISTS (SELECT 1 FROM users \
+         WHERE organization_id = $1 AND lower(email) = lower($2))",
+    )
+    .bind(organization_id)
+    .bind(email.trim())
+    .fetch_one(executor)
+    .await
+}
+
+// ---------------------------------------------------------------------------
+// Invitations
+
+/// Invite `email` as `role`: revoke this organization's other pending
+/// invitations for the same address (any case), delete its expired
+/// unaccepted ones, and insert a new one valid for [`INVITATION_TTL`]. Call
+/// inside a transaction.
+pub async fn create_invitation(
+    conn: &mut sqlx::PgConnection,
+    organization_id: Uuid,
+    email: &str,
+    role: Role,
+    invited_by: Uuid,
+) -> Result<IssuedInvitation, sqlx::Error> {
+    debug_assert!(matches!(role, Role::Owner | Role::Member));
+    sqlx::query(
+        "UPDATE invitations SET revoked_at = now() \
+         WHERE organization_id = $1 AND lower(email) = lower($2) \
+           AND accepted_at IS NULL AND revoked_at IS NULL AND expires_at > now()",
+    )
+    .bind(organization_id)
+    .bind(email)
+    .execute(&mut *conn)
+    .await?;
+    sqlx::query(
+        "DELETE FROM invitations \
+         WHERE organization_id = $1 AND accepted_at IS NULL AND expires_at <= now()",
+    )
+    .bind(organization_id)
+    .execute(&mut *conn)
+    .await?;
+    let token = Token::generate();
+    let (id, created_at, expires_at): (Uuid, String, String) = sqlx::query_as(&format!(
+        "INSERT INTO invitations (organization_id, email, role, token_hash, invited_by, expires_at) \
+         VALUES ($1, $2, $3, $4, $5, now() + make_interval(secs => $6)) \
+         RETURNING id, to_char(created_at AT TIME ZONE 'UTC', {RFC3339_UTC}), \
+                   to_char(expires_at AT TIME ZONE 'UTC', {RFC3339_UTC})"
+    ))
+    .bind(organization_id)
+    .bind(email)
+    .bind(role.as_str())
+    .bind(&token.hash[..])
+    .bind(invited_by)
+    .bind(INVITATION_TTL.as_secs_f64())
+    .fetch_one(&mut *conn)
+    .await?;
+    Ok(IssuedInvitation {
+        token: token.raw,
+        invitation: Invitation {
+            id,
+            email: email.to_string(),
+            role,
+            created_at,
+            expires_at,
+        },
+    })
+}
+
+/// The organization's pending invitations (not accepted, revoked or
+/// expired), oldest first.
+pub async fn pending_invitations<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+) -> Result<Vec<Invitation>, sqlx::Error> {
+    let rows: Vec<(Uuid, String, String, String, String)> = sqlx::query_as(&format!(
+        "SELECT id, email, role, to_char(created_at AT TIME ZONE 'UTC', {RFC3339_UTC}), \
+                to_char(expires_at AT TIME ZONE 'UTC', {RFC3339_UTC}) \
+         FROM invitations \
+         WHERE organization_id = $1 AND accepted_at IS NULL AND revoked_at IS NULL \
+           AND expires_at > now() \
+         ORDER BY created_at, id"
+    ))
+    .bind(organization_id)
+    .fetch_all(executor)
+    .await?;
+    rows.into_iter()
+        .map(|(id, email, role, created_at, expires_at)| {
+            Ok(Invitation {
+                id,
+                email,
+                role: decode_role(&role)?,
+                created_at,
+                expires_at,
+            })
+        })
+        .collect()
+}
+
+/// Revoke one of the organization's pending invitations; returns its email,
+/// or `None` if there is no such pending invitation in this organization.
+pub async fn revoke_invitation<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    organization_id: Uuid,
+    invitation_id: Uuid,
+) -> Result<Option<String>, sqlx::Error> {
+    sqlx::query_scalar(
+        "UPDATE invitations SET revoked_at = now() \
+         WHERE organization_id = $1 AND id = $2 \
+           AND accepted_at IS NULL AND revoked_at IS NULL AND expires_at > now() \
+         RETURNING email",
+    )
+    .bind(organization_id)
+    .bind(invitation_id)
+    .fetch_optional(executor)
+    .await
+}
+
+/// The pending invitation a raw token belongs to (any organization: the
+/// token is the credential), without using it up. `None` for an unknown,
+/// malformed, accepted, revoked or expired token.
+pub async fn peek_invitation<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    raw: &str,
+) -> Result<Option<InvitationPreview>, sqlx::Error> {
+    let Some(hash) = accounts::hash_token(raw) else {
+        return Ok(None);
+    };
+    let row: Option<(String, String, String)> = sqlx::query_as(
+        "SELECT o.name, i.email, i.role FROM invitations i \
+         JOIN organizations o ON o.id = i.organization_id \
+         WHERE i.token_hash = $1 AND i.accepted_at IS NULL AND i.revoked_at IS NULL \
+           AND i.expires_at > now()",
+    )
+    .bind(&hash[..])
+    .fetch_optional(executor)
+    .await?;
+    row.map(|(organization_name, email, role)| {
+        Ok(InvitationPreview {
+            organization_name,
+            email,
+            role: decode_role(&role)?,
+        })
+    })
+    .transpose()
+}
+
+/// Mark a pending invitation accepted: one atomic statement, so of any
+/// number of concurrent uses exactly one gets it. `None` for an unknown,
+/// malformed, accepted, revoked or expired token.
+pub async fn consume_invitation<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    raw: &str,
+) -> Result<Option<AcceptedInvitation>, sqlx::Error> {
+    let Some(hash) = accounts::hash_token(raw) else {
+        return Ok(None);
+    };
+    let row: Option<(Uuid, Uuid, String, String)> = sqlx::query_as(
+        "UPDATE invitations SET accepted_at = now() \
+         WHERE token_hash = $1 AND accepted_at IS NULL AND revoked_at IS NULL \
+           AND expires_at > now() \
+         RETURNING id, organization_id, email, role",
+    )
+    .bind(&hash[..])
+    .fetch_optional(executor)
+    .await?;
+    row.map(|(id, organization_id, email, role)| {
+        Ok(AcceptedInvitation {
+            id,
+            organization_id,
+            email,
+            role: decode_role(&role)?,
+        })
+    })
+    .transpose()
+}
+
+/// Create the invited user in the invitation's organization with its role,
+/// email already verified (following the emailed link proves the mailbox).
+/// A taken email (an account anywhere) is
+/// [`CreateAccountError::DuplicateEmail`], which aborts the transaction.
+pub async fn create_invited_user<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    invitation: &AcceptedInvitation,
+    name: &str,
+    password_hash: &str,
+) -> Result<Uuid, CreateAccountError> {
+    sqlx::query_scalar(
+        "INSERT INTO users (organization_id, email, name, password_hash, role, email_verified_at) \
+         VALUES ($1, $2, $3, $4, $5, now()) RETURNING id",
+    )
+    .bind(invitation.organization_id)
+    .bind(&invitation.email)
+    .bind(name)
+    .bind(password_hash)
+    .bind(invitation.role.as_str())
+    .fetch_one(executor)
+    .await
+    .map_err(|e| match &e {
+        sqlx::Error::Database(d) if d.constraint() == Some("users_email_lower_key") => {
+            CreateAccountError::DuplicateEmail
+        }
+        _ => CreateAccountError::Db(e),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_owner_and_member_are_assignable() {
+        assert_eq!(assignable_role("owner"), Ok(Role::Owner));
+        assert_eq!(assignable_role("member"), Ok(Role::Member));
+        for bad in ["vendor_admin", "admin", "Owner", " member", ""] {
+            assert_eq!(assignable_role(bad), Err(MSG_BAD_ROLE.to_string()), "{bad}");
+        }
+    }
+
+    #[test]
+    fn invitations_last_seven_days() {
+        assert_eq!(INVITATION_TTL.as_secs(), 7 * 24 * 60 * 60);
+    }
+
+    #[test]
+    fn invitation_json_has_no_token() {
+        let inv = Invitation {
+            id: Uuid::nil(),
+            email: "a@example.com".into(),
+            role: Role::Member,
+            created_at: "2026-11-08T00:00:00Z".into(),
+            expires_at: "2026-11-15T00:00:00Z".into(),
+        };
+        let v = serde_json::to_value(&inv).unwrap();
+        let mut keys: Vec<_> = v.as_object().unwrap().keys().cloned().collect();
+        keys.sort();
+        assert_eq!(keys, ["created_at", "email", "expires_at", "id", "role"]);
+        assert_eq!(v["role"], "member");
+    }
+}
diff --git a/crates/wipe-hub/src/team_routes.rs b/crates/wipe-hub/src/team_routes.rs
new file mode 100644
index 0000000..36db160
--- /dev/null
+++ b/crates/wipe-hub/src/team_routes.rs
@@ -0,0 +1,515 @@
+//! Account, organization and team routes (portal-accounts story 4):
+//!
+//! - `POST /api/account/profile` — the signed-in user's own name.
+//! - `GET /api/organization/members` — any role: the organization's users.
+//! - Owner only: `POST /api/organization` (rename),
+//!   `POST|GET /api/organization/invitations`,
+//!   `POST /api/organization/invitations/:id/revoke`,
+//!   `POST /api/organization/members/:id/role`,
+//!   `POST /api/organization/members/:id/remove`.
+//! - Anonymous: `POST /api/invitations/lookup` and
+//!   `POST /api/invitations/accept`.
+//!
+//! The organization acted on is always the signed-in user's, from the
+//! session ([`CurrentUser`]); [`crate::team`] takes it first in every query.
+//! Another organization's user or invitation id is a 404 like an unknown id,
+//! and changes and audits nothing. Owner-only routes answer a `member` or
+//! `vendor_admin` 403 before reading the body, charging a throttle or
+//! writing. Role changes and removals re-check the acting owner and the
+//! owner count under the organization row lock, so an organization always
+//! keeps at least one owner. Every write shares a transaction with its audit
+//! row; the invitation email is sent after commit. Error bodies are
+//! `{"error": "<message>"}`.
+
+use std::net::SocketAddr;
+
+use axum::extract::{ConnectInfo, Path, State};
+use axum::http::header::SET_COOKIE;
+use axum::http::{HeaderMap, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use uuid::Uuid;
+
+use crate::accounts::{self, Account, CreateAccountError, Organization, Role, User};
+use crate::audit::{self, AuditEntry};
+use crate::auth::{
+    actor, charge_mail, ip_key, portal_link, secure, session_cookie, session_token, with_peer,
+    ApiError, CurrentUser, JsonBody, MSG_DUPLICATE_EMAIL, MSG_NOT_SIGNED_IN, MSG_OWNER_ONLY,
+};
+use crate::team::{self, Invitation, InvitationPreview};
+use crate::AppState;
+
+pub const MSG_UNVERIFIED_INVITER: &str = "verify your email address before inviting members";
+pub const MSG_ALREADY_MEMBER: &str = "this person is already a member of your organization";
+pub const MSG_LAST_OWNER: &str = "an organization must keep at least one owner";
+pub const MSG_REMOVE_SELF: &str = "you cannot remove yourself from the organization";
+pub const MSG_NO_MEMBER: &str = "no such member";
+pub const MSG_NO_INVITATION: &str = "no such pending invitation";
+pub const MSG_BAD_INVITATION: &str = "this invitation is invalid or has expired";
+
+/// The portal page the invitation email links to.
+pub const ACCEPT_INVITE_PAGE: &str = "accept-invite";
+
+pub fn routes() -> Router<AppState> {
+    Router::new()
+        .route("/api/account/profile", post(update_profile))
+        .route("/api/organization", post(rename_organization))
+        .route("/api/organization/members", get(list_members))
+        .route("/api/organization/members/:id/role", post(change_role))
+        .route("/api/organization/members/:id/remove", post(remove_member))
+        .route(
+            "/api/organization/invitations",
+            get(list_invitations).post(invite),
+        )
+        .route(
+            "/api/organization/invitations/:id/revoke",
+            post(revoke_invitation),
+        )
+        .route("/api/invitations/lookup", post(lookup_invitation))
+        .route("/api/invitations/accept", post(accept_invitation))
+}
+
+fn bad_request(message: impl Into<String>) -> ApiError {
+    ApiError::new(StatusCode::BAD_REQUEST, message)
+}
+
+fn not_found(message: &str) -> ApiError {
+    ApiError::new(StatusCode::NOT_FOUND, message)
+}
+
+fn conflict(message: &str) -> ApiError {
+    ApiError::new(StatusCode::CONFLICT, message)
+}
+
+/// A path id that is not a UUID names nothing: the same 404 as an unknown id
+/// (not axum's plain-text 400).
+fn path_id(raw: &str, message: &str) -> Result<Uuid, ApiError> {
+    Uuid::parse_str(raw).map_err(|_| not_found(message))
+}
+
+fn organization_subject(organization_id: Uuid) -> String {
+    format!("organization:{organization_id}")
+}
+
+/// Under the organization lock: 403 unless the acting user is still an owner
+/// (they may have been demoted since their session was read).
+async fn require_owner_locked(
+    conn: &mut sqlx::PgConnection,
+    user: &CurrentUser,
+) -> Result<(), ApiError> {
+    match team::member(&mut *conn, user.organization_id, user.user_id).await? {
+        Some(u) if u.role == Role::Owner => Ok(()),
+        _ => Err(ApiError::new(StatusCode::FORBIDDEN, MSG_OWNER_ONLY)),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Profile
+
+#[derive(Debug, Deserialize)]
+pub struct NameRequest {
+    pub name: String,
+}
+
+async fn update_profile(
+    State(state): State<AppState>,
+    user: CurrentUser,
+    JsonBody(req): JsonBody<NameRequest>,
+) -> Result<Json<Account>, ApiError> {
+    let name = accounts::validate_name("name", &req.name).map_err(bad_request)?;
+    let mut tx = state.pool.begin().await?;
+    if !team::set_user_name(&mut *tx, user.organization_id, user.user_id, &name).await? {
+        return Err(ApiError::new(StatusCode::UNAUTHORIZED, MSG_NOT_SIGNED_IN));
+    }
+    let who = actor(user.user_id);
+    // The name itself stays out of the append-only log.
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &who,
+            action: "account.profile_updated",
+            subject: &who,
+            detail: json!({}),
+        },
+    )
+    .await?;
+    let account = accounts::account(&mut *tx, user.organization_id, user.user_id)
+        .await?
+        .ok_or_else(|| ApiError::new(StatusCode::UNAUTHORIZED, MSG_NOT_SIGNED_IN))?;
+    tx.commit().await?;
+    Ok(Json(account))
+}
+
+// ---------------------------------------------------------------------------
+// Organization and members
+
+async fn list_members(
+    State(state): State<AppState>,
+    user: CurrentUser,
+) -> Result<Json<serde_json::Value>, ApiError> {
+    let members = team::members(&state.pool, user.organization_id).await?;
+    Ok(Json(json!({ "members": members })))
+}
+
+async fn rename_organization(
+    State(state): State<AppState>,
+    user: CurrentUser,
+    body: Result<JsonBody<NameRequest>, ApiError>,
+) -> Result<Json<Organization>, ApiError> {
+    user.require_owner()?;
+    let JsonBody(req) = body?;
+    let name = accounts::validate_name("name", &req.name).map_err(bad_request)?;
+    let mut tx = state.pool.begin().await?;
+    let from = team::lock_organization(&mut *tx, user.organization_id)
+        .await?
+        .ok_or_else(|| ApiError::internal("signed-in user's organization vanished"))?;
+    require_owner_locked(&mut tx, &user).await?;
+    team::rename_organization(&mut *tx, user.organization_id, &name).await?;
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &actor(user.user_id),
+            action: "organization.renamed",
+            subject: &organization_subject(user.organization_id),
+            detail: json!({ "from": from, "to": name }),
+        },
+    )
+    .await?;
+    tx.commit().await?;
+    Ok(Json(Organization {
+        id: user.organization_id,
+        name,
+    }))
+}
+
+#[derive(Debug, Deserialize)]
+pub struct RoleRequest {
+    pub role: String,
+}
+
+async fn change_role(
+    State(state): State<AppState>,
+    user: CurrentUser,
+    Path(id): Path<String>,
+    body: Result<JsonBody<RoleRequest>, ApiError>,
+) -> Result<Json<User>, ApiError> {
+    user.require_owner()?;
+    let JsonBody(req) = body?;
+    let role = team::assignable_role(&req.role).map_err(bad_request)?;
+    let target_id = path_id(&id, MSG_NO_MEMBER)?;
+
+    let mut tx = state.pool.begin().await?;
+    team::lock_organization(&mut *tx, user.organization_id).await?;
+    let Some(target) = team::member(&mut *tx, user.organization_id, target_id).await? else {
+        return Err(not_found(MSG_NO_MEMBER));
+    };
+    if target.role == role {
+        return Ok(Json(target));
+    }
+    // The last-owner rule first, so of two owners demoting each other at
+    // once the loser hears 409, whichever check it would also fail.
+    if target.role == Role::Owner && team::owner_count(&mut *tx, user.organization_id).await? <= 1 {
+        return Err(conflict(MSG_LAST_OWNER));
+    }
+    require_owner_locked(&mut tx, &user).await?;
+    team::set_role(&mut *tx, user.organization_id, target_id, role).await?;
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &actor(user.user_id),
+            action: "organization.member_role_changed",
+            subject: &actor(target_id),
+            detail: json!({
+                "organization_id": user.organization_id,
+                "from": target.role,
+                "to": role,
+            }),
+        },
+    )
+    .await?;
+    tx.commit().await?;
+    Ok(Json(User { role, ..target }))
+}
+
+async fn remove_member(
+    State(state): State<AppState>,
+    user: CurrentUser,
+    Path(id): Path<String>,
+) -> Result<StatusCode, ApiError> {
+    user.require_owner()?;
+    let target_id = path_id(&id, MSG_NO_MEMBER)?;
+    if target_id == user.user_id {
+        return Err(conflict(MSG_REMOVE_SELF));
+    }
+
+    let mut tx = state.pool.begin().await?;
+    team::lock_organization(&mut *tx, user.organization_id).await?;
+    let Some(target) = team::member(&mut *tx, user.organization_id, target_id).await? else {
+        return Err(not_found(MSG_NO_MEMBER));
+    };
+    if target.role == Role::Owner && team::owner_count(&mut *tx, user.organization_id).await? <= 1 {
+        return Err(conflict(MSG_LAST_OWNER));
+    }
+    require_owner_locked(&mut tx, &user).await?;
+    let removed = team::remove_member(&mut *tx, user.organization_id, target_id)
+        .await?
+        .ok_or_else(|| not_found(MSG_NO_MEMBER))?;
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &actor(user.user_id),
+            action: "organization.member_removed",
+            subject: &actor(target_id),
+            detail: json!({
+                "organization_id": user.organization_id,
+                "email": removed.email,
+                "role": removed.role,
+                "sessions_ended": removed.sessions_ended,
+            }),
+        },
+    )
+    .await?;
+    tx.commit().await?;
+    Ok(StatusCode::NO_CONTENT)
+}
+
+// ---------------------------------------------------------------------------
+// Invitations (owner side)
+
+#[derive(Debug, Deserialize)]
+pub struct InviteRequest {
+    pub email: String,
+    pub role: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct InviteResponse {
+    pub invitation: Invitation,
+    pub invitation_email_sent: bool,
+}
+
+async fn invite(
+    State(state): State<AppState>,
+    peer: Option<ConnectInfo<SocketAddr>>,
+    user: CurrentUser,
+    body: Result<JsonBody<InviteRequest>, ApiError>,
+) -> Result<Response, ApiError> {
+    user.require_owner()?;
+    let JsonBody(req) = body?;
+    let inviter = accounts::account(&state.pool, user.organization_id, user.user_id)
+        .await?
+        .ok_or_else(|| ApiError::new(StatusCode::UNAUTHORIZED, MSG_NOT_SIGNED_IN))?;
+    if !inviter.user.email_verified {
+        return Err(ApiError::new(StatusCode::FORBIDDEN, MSG_UNVERIFIED_INVITER));
+    }
+    let email = accounts::validate_email(&req.email).map_err(bad_request)?;
+    let role = team::assignable_role(&req.role).map_err(bad_request)?;
+    if team::is_member_email(&state.pool, user.organization_id, &email).await? {
+        return Err(conflict(MSG_ALREADY_MEMBER));
+    }
+    let peer = ip_key(peer.map(|ConnectInfo(addr)| addr));
+    if let Err(refused) = charge_mail(&state, &email, peer.as_deref()).await? {
+        return Ok(refused);
+    }
+
+    let mut tx = state.pool.begin().await?;
+    let issued =
+        team::create_invitation(&mut tx, user.organization_id, &email, role, user.user_id).await?;
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &actor(user.user_id),
+            action: "organization.member_invited",
+            subject: &organization_subject(user.organization_id),
+            detail: with_peer(
+                json!({
+                    "invitation_id": issued.invitation.id,
+                    "email": email,
+                    "role": role,
+                }),
+                peer.as_deref(),
+            ),
+        },
+    )
+    .await?;
+    tx.commit().await?;
+
+    let link = portal_link(
+        &state.config.public_base_url,
+        ACCEPT_INVITE_PAGE,
+        &issued.token,
+    );
+    let sent = match state
+        .mailer
+        .send_invitation(
+            &email,
+            &inviter.organization.name,
+            &inviter.user.name,
+            &link,
+        )
+        .await
+    {
+        Ok(()) => true,
+        Err(e) => {
+            // Never the token.
+            tracing::warn!(error = %e, "invitation email not sent");
+            false
+        }
+    };
+    Ok((
+        StatusCode::CREATED,
+        Json(InviteResponse {
+            invitation: issued.invitation,
+            invitation_email_sent: sent,
+        }),
+    )
+        .into_response())
+}
+
+async fn list_invitations(
+    State(state): State<AppState>,
+    user: CurrentUser,
+) -> Result<Json<serde_json::Value>, ApiError> {
+    user.require_owner()?;
+    let invitations = team::pending_invitations(&state.pool, user.organization_id).await?;
+    Ok(Json(json!({ "invitations": invitations })))
+}
+
+async fn revoke_invitation(
+    State(state): State<AppState>,
+    user: CurrentUser,
+    Path(id): Path<String>,
+) -> Result<StatusCode, ApiError> {
+    user.require_owner()?;
+    let invitation_id = path_id(&id, MSG_NO_INVITATION)?;
+    let mut tx = state.pool.begin().await?;
+    let Some(email) =
+        team::revoke_invitation(&mut *tx, user.organization_id, invitation_id).await?
+    else {
+        return Err(not_found(MSG_NO_INVITATION));
+    };
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &actor(user.user_id),
+            action: "organization.invitation_revoked",
+            subject: &organization_subject(user.organization_id),
+            detail: json!({ "invitation_id": invitation_id, "email": email }),
+        },
+    )
+    .await?;
+    tx.commit().await?;
+    Ok(StatusCode::NO_CONTENT)
+}
+
+// ---------------------------------------------------------------------------
+// Invitations (invitee side, anonymous)
+
+#[derive(Debug, Deserialize)]
+pub struct LookupRequest {
+    pub token: String,
+}
+
+/// Who invited the token's holder, where and as what. Changes nothing.
+async fn lookup_invitation(
+    State(state): State<AppState>,
+    JsonBody(req): JsonBody<LookupRequest>,
+) -> Result<Json<InvitationPreview>, ApiError> {
+    team::peek_invitation(&state.pool, &req.token)
+        .await?
+        .map(Json)
+        .ok_or_else(|| bad_request(MSG_BAD_INVITATION))
+}
+
+#[derive(Debug, Deserialize)]
+pub struct AcceptRequest {
+    pub token: String,
+    pub name: String,
+    pub password: String,
+}
+
+/// Accept an invitation: validate (an invalid name or password never burns
+/// the token), peek the token before Argon2, then in one transaction consume
+/// it, create the user in the invitation's organization with its role and a
+/// verified email, rotate the incoming session (whoever's) and sign in. A
+/// taken email rolls everything back, leaving the invitation pending.
+async fn accept_invitation(
+    State(state): State<AppState>,
+    peer: Option<ConnectInfo<SocketAddr>>,
+    headers: HeaderMap,
+    JsonBody(req): JsonBody<AcceptRequest>,
+) -> Result<Response, ApiError> {
+    let name = accounts::validate_name("name", &req.name).map_err(bad_request)?;
+    accounts::validate_password(&req.password).map_err(bad_request)?;
+    if team::peek_invitation(&state.pool, &req.token)
+        .await?
+        .is_none()
+    {
+        return Err(bad_request(MSG_BAD_INVITATION));
+    }
+    let password_hash = accounts::hash_password(req.password).await?;
+    let peer = ip_key(peer.map(|ConnectInfo(addr)| addr));
+
+    let mut tx = state.pool.begin().await?;
+    // Another request may have used the token since the peek.
+    let Some(invitation) = team::consume_invitation(&mut *tx, &req.token).await? else {
+        return Err(bad_request(MSG_BAD_INVITATION));
+    };
+    let user_id =
+        match team::create_invited_user(&mut *tx, &invitation, &name, &password_hash).await {
+            Ok(id) => id,
+            // Dropping `tx` rolls back the consume: the invitation stays pending.
+            Err(CreateAccountError::DuplicateEmail) => return Err(conflict(MSG_DUPLICATE_EMAIL)),
+            Err(CreateAccountError::Db(e)) => return Err(e.into()),
+        };
+    let rotated = match session_token(&headers) {
+        Some(old) => accounts::delete_session(&mut *tx, &old).await?.is_some(),
+        None => false,
+    };
+    let session = accounts::create_session(&mut *tx, user_id).await?;
+    let who = actor(user_id);
+    audit::record(
+        &mut *tx,
+        &AuditEntry {
+            actor: &who,
+            action: "organization.invitation_accepted",
+            subject: &who,
+            detail: with_peer(
+                json!({
+                    "invitation_id": invitation.id,
+                    "organization_id": invitation.organization_id,
+                    "role": invitation.role,
+                    "rotated": rotated,
+                }),
+                peer.as_deref(),
+            ),
+        },
+    )
+    .await?;
+    let account = accounts::account(&mut *tx, invitation.organization_id, user_id)
+        .await?
+        .ok_or_else(|| ApiError::internal("invited user vanished"))?;
+    tx.commit().await?;
+
+    let mut resp = (StatusCode::CREATED, Json(account)).into_response();
+    resp.headers_mut()
+        .insert(SET_COOKIE, session_cookie(&session, secure(&state)));
+    Ok(resp)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn non_uuid_path_ids_are_404() {
+        let e = path_id("not-a-uuid", MSG_NO_MEMBER).unwrap_err();
+        assert_eq!(e.status, StatusCode::NOT_FOUND);
+        assert_eq!(e.message, MSG_NO_MEMBER);
+        let id = Uuid::new_v4();
+        assert_eq!(path_id(&id.to_string(), MSG_NO_INVITATION).unwrap(), id);
+    }
+}
