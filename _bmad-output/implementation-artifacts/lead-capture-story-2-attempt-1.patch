diff --git a/apps/portal/src/pages/AdminLeadPage.tsx b/apps/portal/src/pages/AdminLeadPage.tsx
new file mode 100644
index 0000000..7e947d9
--- /dev/null
+++ b/apps/portal/src/pages/AdminLeadPage.tsx
@@ -0,0 +1,271 @@
+import { useState, type FormEvent } from "react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Link, useNavigate } from "@tanstack/react-router";
+import { fetchMe } from "@/api/auth";
+import { retryAdminQuery } from "@/api/admin";
+import {
+  STATUSES,
+  addLeadNote,
+  eraseLead,
+  fetchLead,
+  setLeadStatus,
+  type LeadDetail,
+  type LeadStatus,
+} from "@/api/adminLeads";
+import { SignInPrompt } from "./AccountPage";
+import { FormError, SubmitButton } from "./AuthForm";
+import { Select, segmentLabel } from "./AdminLeadsPage";
+
+/**
+ * `/admin/leads/$id`: one sales lead for vendor admins, with every
+ * submission and the exact consent text agreed to, its status, notes, and
+ * erasure. Opening it is an audited view on the hub, so a change updates the
+ * page from the hub's answer and never refetches (which would be another
+ * audited view).
+ */
+export function AdminLeadPage({ id }: { id: string }) {
+  const me = useQuery({ queryKey: ["me"], queryFn: () => fetchMe(), retry: false });
+
+  return (
+    <section className="space-y-6">
+      <p className="text-sm">
+        <Link to="/admin/leads" className="text-indigo-400 hover:underline">
+          Back to sales leads
+        </Link>
+      </p>
+      {me.isPending && <p className="text-sm text-slate-400">Loading…</p>}
+      {me.isError && (
+        <p role="alert" className="text-sm text-rose-400">
+          Could not load your account: {me.error instanceof Error ? me.error.message : "unknown error"}
+        </p>
+      )}
+      {me.data === null && <SignInPrompt />}
+      {me.data && <Detail id={id} />}
+    </section>
+  );
+}
+
+function Detail({ id }: { id: string }) {
+  const queryKey = ["admin", "lead", id];
+  const detail = useQuery({
+    queryKey,
+    queryFn: () => fetchLead(id),
+    refetchOnWindowFocus: false,
+    refetchOnMount: false,
+    refetchOnReconnect: false,
+    staleTime: Infinity,
+    // Dropped as soon as the page unmounts: never shown to a later user.
+    gcTime: 0,
+    retry: retryAdminQuery,
+  });
+  const queryClient = useQueryClient();
+  /** Apply a change's answer to the page without refetching. */
+  const update = (f: (d: LeadDetail) => LeadDetail) =>
+    queryClient.setQueryData<LeadDetail>(queryKey, (d) => (d ? f(d) : d));
+
+  return (
+    <>
+      {detail.isPending && <p className="text-sm text-slate-400">Loading…</p>}
+      <FormError error={detail.error} />
+      {detail.data && <LeadView id={id} detail={detail.data} update={update} />}
+    </>
+  );
+}
+
+function LeadView({
+  id,
+  detail,
+  update,
+}: {
+  id: string;
+  detail: LeadDetail;
+  update: (f: (d: LeadDetail) => LeadDetail) => void;
+}) {
+  const { lead, submissions, notes } = detail;
+  return (
+    <>
+      <div className="space-y-1">
+        <h1 className="text-xl font-semibold">{lead.name}</h1>
+        <p className="text-sm text-slate-300">
+          {lead.email} · {lead.company}
+          {lead.role && ` · ${lead.role}`}
+        </p>
+        <p className="text-sm text-slate-400">
+          Segment {segmentLabel(lead.segment)} · first submitted {lead.created_at.slice(0, 10)} ·{" "}
+          {lead.id}
+        </p>
+        {lead.unsubscribed_at && (
+          <p className="text-sm text-amber-400">
+            Unsubscribed {lead.unsubscribed_at.slice(0, 10)}
+          </p>
+        )}
+      </div>
+
+      <StatusForm
+        id={id}
+        status={lead.status}
+        onSaved={(l) => update((d) => ({ ...d, lead: l }))}
+      />
+
+      <div className="space-y-2">
+        <h2 className="text-sm font-medium text-slate-400">Submissions</h2>
+        <ul className="space-y-3">
+          {submissions.map((s) => (
+            <li key={s.id} className="space-y-1 rounded-md border border-slate-800 p-3 text-sm">
+              <p className="text-slate-400">
+                {s.kind === "early-access" ? "Early access" : "Contact"} · {s.consented_at}
+              </p>
+              {s.message && <p className="whitespace-pre-wrap">{s.message}</p>}
+              <p className="text-xs text-slate-400">Consented to: “{s.consent_text}”</p>
+            </li>
+          ))}
+        </ul>
+      </div>
+
+      <div className="space-y-2">
+        <h2 className="text-sm font-medium text-slate-400">Notes</h2>
+        <NoteForm
+          id={id}
+          onAdded={(n) => update((d) => ({ ...d, notes: [n, ...d.notes] }))}
+        />
+        {notes.length === 0 ? (
+          <p className="text-sm text-slate-400">No notes yet.</p>
+        ) : (
+          <ul className="space-y-2">
+            {notes.map((n) => (
+              <li key={n.id} className="text-sm">
+                <p className="text-xs text-slate-400">
+                  {n.created_at} · {n.author ? n.author.name : "removed user"}
+                </p>
+                <p className="whitespace-pre-wrap">{n.body}</p>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+
+      <EraseButton id={id} />
+    </>
+  );
+}
+
+function StatusForm({
+  id,
+  status,
+  onSaved,
+}: {
+  id: string;
+  status: LeadStatus;
+  onSaved: (lead: LeadDetail["lead"]) => void;
+}) {
+  const [value, setValue] = useState<LeadStatus>(status);
+  const save = useMutation({
+    mutationFn: (s: LeadStatus) => setLeadStatus(id, s),
+    onSuccess: onSaved,
+  });
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    save.mutate(value);
+  }
+  return (
+    <form onSubmit={onSubmit} className="flex max-w-sm items-end gap-3">
+      <div className="flex-1">
+        <Select
+          label="Status"
+          name="status"
+          value={value}
+          onChange={(v) => setValue(v as LeadStatus)}
+          options={STATUSES.map((s) => ({ value: s, label: s }))}
+        />
+      </div>
+      <SubmitButton pending={save.isPending}>Save status</SubmitButton>
+      <FormError error={save.error} />
+    </form>
+  );
+}
+
+function NoteForm({
+  id,
+  onAdded,
+}: {
+  id: string;
+  onAdded: (note: LeadDetail["notes"][number]) => void;
+}) {
+  const [body, setBody] = useState("");
+  const add = useMutation({
+    mutationFn: (b: string) => addLeadNote(id, b),
+    onSuccess: (note) => {
+      setBody("");
+      onAdded(note);
+    },
+  });
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    add.mutate(body);
+  }
+  return (
+    <form onSubmit={onSubmit} className="max-w-xl space-y-2">
+      <label className="block space-y-1 text-sm">
+        <span className="text-slate-300">New note</span>
+        <textarea
+          name="note"
+          required
+          rows={3}
+          value={body}
+          onChange={(e) => setBody(e.target.value)}
+          className="w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100 focus:border-indigo-500 focus:outline-none"
+        />
+      </label>
+      <SubmitButton pending={add.isPending}>Add note</SubmitButton>
+      <FormError error={add.error} />
+    </form>
+  );
+}
+
+/** Erasure needs a second, confirming press; then back to the list. */
+function EraseButton({ id }: { id: string }) {
+  const navigate = useNavigate();
+  const [confirming, setConfirming] = useState(false);
+  const erase = useMutation({
+    mutationFn: () => eraseLead(id),
+    onSuccess: () => navigate({ to: "/admin/leads" }),
+  });
+  return (
+    <div className="space-y-2 border-t border-slate-800 pt-4">
+      <h2 className="text-sm font-medium text-slate-400">Erase</h2>
+      <p className="text-sm text-slate-400">
+        Deletes this lead, every submission and every note for good. The audit log keeps only that
+        an erasure happened.
+      </p>
+      {confirming ? (
+        <div className="flex gap-3">
+          <button
+            type="button"
+            disabled={erase.isPending}
+            onClick={() => erase.mutate()}
+            className="rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-500 disabled:opacity-50"
+          >
+            Erase permanently
+          </button>
+          <button
+            type="button"
+            disabled={erase.isPending}
+            onClick={() => setConfirming(false)}
+            className="rounded-md border border-slate-700 px-4 py-2 text-sm text-slate-200 hover:bg-slate-800"
+          >
+            Cancel
+          </button>
+        </div>
+      ) : (
+        <button
+          type="button"
+          onClick={() => setConfirming(true)}
+          className="rounded-md border border-rose-700 px-4 py-2 text-sm font-medium text-rose-300 hover:bg-rose-950"
+        >
+          Erase lead
+        </button>
+      )}
+      <FormError error={erase.error} />
+    </div>
+  );
+}
diff --git a/apps/portal/src/pages/AdminLeadsPage.tsx b/apps/portal/src/pages/AdminLeadsPage.tsx
new file mode 100644
index 0000000..02d7f1a
--- /dev/null
+++ b/apps/portal/src/pages/AdminLeadsPage.tsx
@@ -0,0 +1,251 @@
+import { useState, type FormEvent } from "react";
+import { useMutation, useQuery } from "@tanstack/react-query";
+import { Link } from "@tanstack/react-router";
+import { fetchMe } from "@/api/auth";
+import { retryAdminQuery } from "@/api/admin";
+import {
+  NO_FILTERS,
+  SEGMENTS,
+  SEGMENT_NONE,
+  STATUSES,
+  exportLeads,
+  listLeads,
+  type AdminLead,
+  type LeadFilters,
+} from "@/api/adminLeads";
+import { SignInPrompt } from "./AccountPage";
+import { Field, FormError, SubmitButton } from "./AuthForm";
+
+/**
+ * `/admin/leads`: vendor admins list sales leads by segment, status and
+ * submission date, and download them as CSV. Each list run and each export
+ * is audited on the hub, so the list runs only when the form is submitted,
+ * and the export uses the filters of the last run, never unsubmitted edits.
+ */
+export function AdminLeadsPage() {
+  const me = useQuery({ queryKey: ["me"], queryFn: () => fetchMe(), retry: false });
+
+  return (
+    <section className="space-y-6">
+      <p className="text-sm">
+        <Link to="/admin" className="text-indigo-400 hover:underline">
+          Back to the admin area
+        </Link>
+      </p>
+      <h1 className="text-xl font-semibold">Sales leads</h1>
+      {me.isPending && <p className="text-sm text-slate-400">Loading…</p>}
+      {me.isError && (
+        <p role="alert" className="text-sm text-rose-400">
+          Could not load your account: {me.error instanceof Error ? me.error.message : "unknown error"}
+        </p>
+      )}
+      {me.data === null && <SignInPrompt />}
+      {me.data && (
+        <>
+          <p className="text-sm text-slate-400">
+            Every list, lead you open and export is recorded in the audit log.
+          </p>
+          <Leads />
+        </>
+      )}
+    </section>
+  );
+}
+
+const SEGMENT_LABELS: Record<string, string> = {
+  itad: "ITAD",
+  "enterprise-it": "Enterprise IT",
+  government: "Government",
+  other: "Other",
+  [SEGMENT_NONE]: "None (contact form)",
+};
+
+export function segmentLabel(segment: string | null): string {
+  return segment === null ? "—" : (SEGMENT_LABELS[segment] ?? segment);
+}
+
+export function Select({
+  label,
+  name,
+  value,
+  onChange,
+  options,
+}: {
+  label: string;
+  name: string;
+  value: string;
+  onChange: (v: string) => void;
+  options: { value: string; label: string }[];
+}) {
+  return (
+    <label className="block space-y-1 text-sm">
+      <span className="text-slate-300">{label}</span>
+      <select
+        name={name}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        className="w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100 focus:border-indigo-500 focus:outline-none"
+      >
+        {options.map((o) => (
+          <option key={o.value} value={o.value}>
+            {o.label}
+          </option>
+        ))}
+      </select>
+    </label>
+  );
+}
+
+/** Hand a downloaded file to the browser. */
+function saveFile(blob: Blob, filename: string) {
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = filename;
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  URL.revokeObjectURL(url);
+}
+
+function Leads() {
+  const [draft, setDraft] = useState<LeadFilters>(NO_FILTERS);
+  // Each submit gets a new sequence number, so it is a new query key and
+  // runs the list again even when the filters are unchanged.
+  const [submitted, setSubmitted] = useState<{ filters: LeadFilters; n: number } | null>(null);
+  const set = (key: keyof LeadFilters) => (v: string) => setDraft((d) => ({ ...d, [key]: v }));
+
+  const list = useQuery({
+    queryKey: ["admin", "leads", submitted],
+    queryFn: () => listLeads(submitted?.filters ?? NO_FILTERS),
+    enabled: submitted !== null,
+    refetchOnWindowFocus: false,
+    refetchOnMount: false,
+    refetchOnReconnect: false,
+    staleTime: Infinity,
+    // Never keep lead data once the page unmounts.
+    gcTime: 0,
+    retry: retryAdminQuery,
+  });
+
+  const exporter = useMutation({
+    mutationFn: (filters: LeadFilters) => exportLeads(filters),
+    onSuccess: ({ blob, filename }) => saveFile(blob, filename),
+  });
+
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    exporter.reset();
+    setSubmitted((prev) => ({ filters: draft, n: (prev?.n ?? 0) + 1 }));
+  }
+
+  return (
+    <div className="space-y-4">
+      <form onSubmit={onSubmit} className="grid max-w-2xl grid-cols-2 items-end gap-3 sm:grid-cols-4">
+        <Select
+          label="Segment"
+          name="segment"
+          value={draft.segment}
+          onChange={set("segment")}
+          options={[
+            { value: "", label: "Any" },
+            ...[...SEGMENTS, SEGMENT_NONE].map((s) => ({ value: s, label: segmentLabel(s) })),
+          ]}
+        />
+        <Select
+          label="Status"
+          name="status"
+          value={draft.status}
+          onChange={set("status")}
+          options={[{ value: "", label: "Any" }, ...STATUSES.map((s) => ({ value: s, label: s }))]}
+        />
+        <Field
+          label="Submitted from (UTC)"
+          name="from"
+          type="date"
+          required={false}
+          value={draft.from}
+          onChange={set("from")}
+        />
+        <Field
+          label="Submitted to (UTC)"
+          name="to"
+          type="date"
+          required={false}
+          value={draft.to}
+          onChange={set("to")}
+        />
+        <div className="col-span-2 flex gap-3 sm:col-span-4">
+          <SubmitButton pending={list.isFetching}>Show leads</SubmitButton>
+          <button
+            type="button"
+            disabled={submitted === null || exporter.isPending}
+            onClick={() => submitted && exporter.mutate(submitted.filters)}
+            className="rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 disabled:opacity-50"
+          >
+            Export CSV
+          </button>
+        </div>
+      </form>
+      {submitted === null && (
+        <p className="text-sm text-slate-400">Show leads first; Export CSV uses the same filters.</p>
+      )}
+      <FormError error={list.error} />
+      <FormError error={exporter.error} />
+      {list.data && <LeadTable leads={list.data.leads} />}
+      {list.data?.truncated && (
+        <p className="text-sm text-amber-400">
+          Showing the first 100 leads. Narrow the filters to see the rest, or export them all.
+        </p>
+      )}
+    </div>
+  );
+}
+
+function LeadTable({ leads }: { leads: AdminLead[] }) {
+  if (leads.length === 0) return <p className="text-sm text-slate-400">No leads match.</p>;
+  return (
+    <table className="w-full text-left text-sm">
+      <thead className="text-slate-400">
+        <tr>
+          <th className="py-1 pr-3 font-medium">Name</th>
+          <th className="py-1 pr-3 font-medium">Email</th>
+          <th className="py-1 pr-3 font-medium">Company</th>
+          <th className="py-1 pr-3 font-medium">Segment</th>
+          <th className="py-1 pr-3 font-medium">Status</th>
+          <th className="py-1 font-medium">Last submitted</th>
+        </tr>
+      </thead>
+      <tbody className="divide-y divide-slate-800">
+        {leads.map((l) => (
+          <tr key={l.id}>
+            <td className="py-1 pr-3">
+              <Link
+                to="/admin/leads/$id"
+                params={{ id: l.id }}
+                className="text-indigo-400 hover:underline"
+              >
+                {l.name}
+              </Link>
+            </td>
+            <td className="py-1 pr-3">
+              {l.email}
+              {l.unsubscribed_at && (
+                <span className="block text-xs text-amber-400">
+                  Unsubscribed {l.unsubscribed_at.slice(0, 10)}
+                </span>
+              )}
+            </td>
+            <td className="py-1 pr-3">{l.company}</td>
+            <td className="py-1 pr-3">{segmentLabel(l.segment)}</td>
+            <td className="py-1 pr-3">{l.status}</td>
+            <td className="py-1 text-slate-400">
+              {l.last_submitted_at?.slice(0, 10) ?? "—"}
+              {l.submission_count > 1 && ` (${l.submission_count})`}
+            </td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
