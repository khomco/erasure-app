+    let mut ev = s.event("checkout.session.completed", &session2, &id2);
+    ev["data"]["object"]["customer"] = json!("cus_new");
+    received(deliver(&s.hub, &bytes(&ev)).await).await;
+    assert_eq!(s.status(&id2).await, "paid");
