+
+    // `async_payment_failed` on a pending order: expired.
+    let (_, id, session) = s.checkout().await;
+    let failed = s.event("checkout.session.async_payment_failed", &session, &id);
+    received(deliver(&s.hub, &bytes(&failed)).await).await;
