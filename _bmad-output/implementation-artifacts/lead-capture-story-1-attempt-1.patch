+#[tokio::test]
+async fn invalid_submissions_are_400_and_change_nothing() {
+    let hub = spawn_hub().await;
+    let email = unique_address();
+    let cases: Vec<(Value, &str)> = vec![
+        (
+            {
+                let mut b = early_access(&email);
