+async fn assert_locked(resp: Response) {
+    let retry: u64 = resp
+        .headers()
+        .get(RETRY_AFTER)
+        .expect("Retry-After")
+        .to_str()
+        .unwrap()
+        .parse()
+        .unwrap();
+    assert!((1..=900).contains(&retry), "{retry}");
+    assert!(resp.headers().get(SET_COOKIE).is_none());
+    assert_eq!(
+        error_of(resp).await,
+        (StatusCode::TOO_MANY_REQUESTS, LOCKED.into())
+    );
+}
