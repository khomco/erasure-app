diff --git a/crates/wipe-hub/src/throttle.rs b/crates/wipe-hub/src/throttle.rs
new file mode 100644
index 0000000..569984c
--- /dev/null
+++ b/crates/wipe-hub/src/throttle.rs
@@ -0,0 +1,187 @@
+//! Failure throttles (ADR-0007 §3): shared, restart-proof counters in the
+//! `auth_throttle` table, keyed by what is throttled (`email:<address>`,
+//! `ip:<peer address>`).
+//!
+//! - A key counts failures in a fixed window that starts at its first
+//!   failure; a failure after the window elapsed starts a new one.
+//! - The failure that reaches the limit locks the key for one window
+//!   (`locked_until = now() + window`). Callers [`check`] before doing any
+//!   work and must not [`record_failure`] while locked, so locked attempts
+//!   never extend the lock.
+//! - [`clear`] forgets a key (e.g. after a successful sign-in).
+//!
+//! Every function takes any Postgres executor, so a failure and its audit row
+//! share a transaction. Story 3 (reset and magic link) reuses this module
+//! with its own keys and limits.
+
+use std::time::Duration;
+
+/// Failed sign-ins per email address before it is locked.
+pub const SIGN_IN_EMAIL_LIMIT: i32 = 5;
+/// Failed sign-ins per client IP before it is locked.
+pub const SIGN_IN_IP_LIMIT: i32 = 20;
+/// The fixed window sign-in failures are counted in.
+pub const SIGN_IN_WINDOW: Duration = Duration::from_secs(15 * 60);
+/// How long a sign-in lock lasts: one window, since [`record_failure`] locks
+/// a key for the window it was given.
+pub const SIGN_IN_LOCKOUT: Duration = SIGN_IN_WINDOW;
+
+/// Rows whose window started longer ago than this, and whose lock (if any)
+/// has elapsed, are purged opportunistically. Every window passed to
+/// [`record_failure`] must be no longer than this.
+pub const PURGE_AFTER: Duration = Duration::from_secs(24 * 60 * 60);
+
+/// Whether a key may be attempted now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Throttle {
+    Open,
+    /// Locked for `retry_after_secs` more whole seconds (at least 1).
+    Locked {
+        retry_after_secs: u64,
+    },
+}
+
+impl Throttle {
+    /// The longer-locked of two statuses.
+    pub fn max(self, other: Throttle) -> Throttle {
+        match (self, other) {
+            (Throttle::Open, t) | (t, Throttle::Open) => t,
+            (
+                Throttle::Locked {
+                    retry_after_secs: a,
+                },
+                Throttle::Locked {
+                    retry_after_secs: b,
+                },
+            ) => Throttle::Locked {
+                retry_after_secs: a.max(b),
+            },
+        }
+    }
+}
+
+/// What [`record_failure`] did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Failure {
+    /// Failures counted in the current window, including this one.
+    pub failures: i32,
+    /// `Some(locked_until)` (RFC 3339, UTC) when this call engaged the lock.
+    pub locked_until: Option<String>,
+}
+
+/// Whether `key` is locked now.
+pub async fn check<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    key: &str,
+) -> Result<Throttle, sqlx::Error> {
+    let secs: Option<i64> = sqlx::query_scalar(
+        "SELECT ceil(extract(epoch FROM locked_until - now()))::bigint \
+         FROM auth_throttle WHERE key = $1 AND locked_until > now()",
+    )
+    .bind(key)
+    .fetch_optional(executor)
+    .await?;
+    Ok(match secs {
+        Some(s) => Throttle::Locked {
+            retry_after_secs: s.max(1) as u64,
+        },
+        None => Throttle::Open,
+    })
+}
+
+/// Count one failure against `key`, atomically: restart the window if it
+/// elapsed, and lock the key for `window` when this failure brings it to
+/// `limit`. Also purges stale rows (see [`PURGE_AFTER`]).
+pub async fn record_failure<'e, E: sqlx::PgExecutor<'e>>(
+    executor: E,
+    key: &str,
+    limit: i32,
+    window: Duration,
+) -> Result<Failure, sqlx::Error> {
+    debug_assert!(window <= PURGE_AFTER);
+    // One statement, so any executor works. `prior` sees the row before this
+    // statement and RETURNING sees it after, so the pair says whether this
+    // call engaged the lock. The purge skips `key`, which the upsert owns.
+    let (failures, locked_now, was_locked, until): (i32, bool, bool, Option<String>) =
+        sqlx::query_as(
+            "WITH purged AS ( \
+                 DELETE FROM auth_throttle \
+                 WHERE key <> $1 \
+                   AND window_started_at < now() - make_interval(secs => $4) \
+                   AND (locked_until IS NULL OR locked_until <= now()) \
+             ), \
+             prior AS ( \
+                 SELECT locked_until > now() AS locked FROM auth_throttle WHERE key = $1 \
+             ), \
+             upserted AS ( \
+                 INSERT INTO auth_throttle AS t (key, failures, window_started_at, locked_until) \
+                 VALUES ($1, 1, now(), \
+                         CASE WHEN 1 >= $2 THEN now() + make_interval(secs => $3) END) \
+                 ON CONFLICT (key) DO UPDATE SET \
+                     failures = CASE \
+                         WHEN t.window_started_at + make_interval(secs => $3) <= now() THEN 1 \
+                         ELSE t.failures + 1 END, \
+                     window_started_at = CASE \
+                         WHEN t.window_started_at + make_interval(secs => $3) <= now() THEN now() \
+                         ELSE t.window_started_at END, \
+                     locked_until = CASE \
+                         WHEN t.locked_until > now() THEN t.locked_until \
+                         WHEN (CASE \
+                                 WHEN t.window_started_at + make_interval(secs => $3) <= now() \
+                                 THEN 1 ELSE t.failures + 1 END) >= $2 \
+                             THEN now() + make_interval(secs => $3) \
+                         ELSE NULL END \
+                 RETURNING failures, locked_until \
+             ) \
+             SELECT u.failures, \
+                    coalesce(u.locked_until > now(), false), \
+                    coalesce((SELECT locked FROM prior), false), \
+                    to_char(u.locked_until AT TIME ZONE 'UTC', \
+                            'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') \
+             FROM upserted u",
+        )
+        .bind(key)
+        .bind(limit)
+        .bind(window.as_secs_f64())
+        .bind(PURGE_AFTER.as_secs_f64())
+        .fetch_one(executor)
+        .await?;
+    Ok(Failure {
+        failures,
+        locked_until: (locked_now && !was_locked).then(|| until.unwrap_or_default()),
+    })
+}
+
+/// Forget `key`'s failures and any lock.
+pub async fn clear<'e, E: sqlx::PgExecutor<'e>>(executor: E, key: &str) -> Result<(), sqlx::Error> {
+    sqlx::query("DELETE FROM auth_throttle WHERE key = $1")
+        .bind(key)
+        .execute(executor)
+        .await?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn max_prefers_the_longer_lock() {
+        let l = |s| Throttle::Locked {
+            retry_after_secs: s,
+        };
+        assert_eq!(Throttle::Open.max(Throttle::Open), Throttle::Open);
+        assert_eq!(Throttle::Open.max(l(3)), l(3));
+        assert_eq!(l(3).max(Throttle::Open), l(3));
+        assert_eq!(l(3).max(l(9)), l(9));
+    }
+
+    #[test]
+    fn sign_in_constants() {
+        assert_eq!(SIGN_IN_EMAIL_LIMIT, 5);
+        assert_eq!(SIGN_IN_IP_LIMIT, 20);
+        assert_eq!(SIGN_IN_WINDOW.as_secs(), 900);
+        assert_eq!(SIGN_IN_LOCKOUT, SIGN_IN_WINDOW);
+        assert!(SIGN_IN_WINDOW <= PURGE_AFTER);
+    }
+}
