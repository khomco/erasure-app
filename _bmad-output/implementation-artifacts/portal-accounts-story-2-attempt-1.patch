--- /dev/null
+++ b/crates/wipe-hub/migrations/0004_auth_throttle.sql
@@ -0,0 +1,13 @@
+-- Failure throttles (ADR-0007 §3, portal-accounts story 2): shared,
+-- restart-proof counters keyed by what is being throttled, e.g.
+-- `email:<address>` or `ip:<peer address>`. Written only through
+-- `wipe_hub::throttle`. A row counts failures in a fixed window starting at
+-- the first failure; `locked_until` is set when a limit is reached.
+-- Never edit an applied migration; add a new NNNN_name.sql.
+
+CREATE TABLE auth_throttle (
+    key               text PRIMARY KEY CHECK (key ~ '\S'),
+    failures          int NOT NULL CHECK (failures > 0),
+    window_started_at timestamptz NOT NULL,
+    locked_until      timestamptz
+);
