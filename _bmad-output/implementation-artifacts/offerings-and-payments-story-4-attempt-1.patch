+    assert_eq!(s.entitlement(&id).await.2, 12);
+    assert!(s.renewals().await.is_empty());
+    let actions: Vec<String> = s
+        .entitlement_audits(&id)
+        .await
+        .into_iter()
+        .map(|a| a.0)
+        .collect();
