+    let again = s.sub_event("customer.subscription.deleted", &id, &[]);
+    assert_eq!(s.deliver_ok(&again).await.as_deref(), Some("unchanged"));
+    let late = renewal(&s, &id, "sub_test_1", "in_test_1");
