+#[tokio::test]
+async fn a_subscription_stripe_ends_keeps_its_seats_until_the_term_ends() {
+    let s = shop().await;
+    let id = s.subscribed("sub_test_1", "in_test_0").await;
+    let ended = s.sub_event("customer.subscription.deleted", &id, &[]);
