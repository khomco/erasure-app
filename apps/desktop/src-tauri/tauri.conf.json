{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wipestation",
  "version": "0.1.0",
  "identifier": "dev.wipestation.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wipestation",
        "url": "http://127.0.0.1:7878",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
